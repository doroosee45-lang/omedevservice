PORT=10000
MONGO_URI=mongodb+srv://your_db_user:your_db_password@your_cluster.mongodb.net/your_db_name?appName=Cluster0

JWT_SECRET=change_this_to_a_random_secret_64_chars
JWT_REFRESH_SECRET=change_this_to_another_random_secret
JWT_EXPIRE=30d

# SMTP (Gmail) — abandonné : Render bloque/timeout les connexions
# sortantes vers smtp.gmail.com:587, indépendamment des identifiants
# (voir RESEND_API_KEY plus bas, qui l'a remplacé).
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USER=your_gmail@gmail.com
# EMAIL_PASS=your_gmail_app_password

# Toujours nécessaire : adresse qui reçoit les notifications internes
# (nouveau contact, devis, inscription...), indépendamment du mécanisme
# d'envoi utilisé.
CONTACT_EMAIL=your_gmail@gmail.com

ANTHROPIC_API_KEY=sk-ant-api03-...
FRONTEND_URL=https://omedev-frontend.onrender.com
NODE_ENV=production

# Stockage des images d'articles de blog (Cloudinary) - le disque local de
# l'hébergeur est éphémère, ces identifiants sont nécessaires pour que les
# images uploadées via l'admin survivent aux redéploiements/redémarrages.
# Compte gratuit sur https://cloudinary.com/ (Dashboard -> Product Environment Credentials)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Envoi d'emails (Resend - API HTTPS, remplace le SMTP Gmail ci-dessus).
# Compte gratuit sur https://resend.com/
RESEND_API_KEY=re_your_resend_api_key
# Sans domaine vérifié sur resend.com/domains, Resend n'autorise l'envoi
# qu'à l'adresse du titulaire du compte (mode bac à sable). Une fois un
# domaine vérifié, définir l'adresse d'expédition à utiliser à la place :
# RESEND_FROM_EMAIL=contact@votre-domaine.com
